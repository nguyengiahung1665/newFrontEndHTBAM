# ==========================================================
# GEMINI LLM CONFIGURATION
# Copy file này thành infra/.env và thay placeholder bằng key thật.
#
# LẤY KEY:
# Google AI Studio -> API Keys
#
# TUYỆT ĐỐI KHÔNG COMMIT .env LÊN GIT
# ==========================================================

GEMINI_MODEL=gemini-2.5-pro

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# THAY KEY THẬT TẠI DÒNG DƯỚI:
GEMINI_API_KEY=PASTE_YOUR_REAL_GEMINI_API_KEY_HERE
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

